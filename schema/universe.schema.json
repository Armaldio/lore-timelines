{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-timelines.local/schema/universe.schema.json",
  "title": "Lore Timelines Universe",
  "type": "object",
  "required": ["id", "title", "subtitle", "description", "worlds", "characters", "sources", "events", "edges"],
  "properties": {
    "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" }, "description": { "type": "string" },
    "worlds": { "type": "array", "items": { "$ref": "#/$defs/world" } },
    "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "world": { "type": "object", "required": ["id", "name", "summary", "tone"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "summary": { "type": "string" }, "tone": { "enum": ["teal", "coral", "gold"] } }, "additionalProperties": false },
    "character": { "type": "object", "required": ["id", "name"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" } }, "additionalProperties": false },
    "source": { "type": "object", "required": ["id", "title", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "kind": { "enum": ["film", "book", "episode", "reference"] }, "url": { "type": "string", "format": "uri" } }, "additionalProperties": false },
    "placement": { "oneOf": [
      { "type": "object", "required": ["kind", "label", "value"], "properties": { "kind": { "const": "exact" }, "label": { "type": "string" }, "value": { "type": "string" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "label"], "properties": { "kind": { "const": "range" }, "label": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "label"], "properties": { "kind": { "const": "relative" }, "label": { "type": "string" }, "after": { "$ref": "#/$defs/id" }, "before": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "label"], "properties": { "kind": { "const": "unknown" }, "label": { "type": "string" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "label", "alternatives"], "properties": { "kind": { "const": "disputed" }, "label": { "type": "string" }, "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false }
    ] },
    "event": { "type": "object", "required": ["id", "title", "description", "placement", "worldId", "spoiler", "sourceIds", "characterIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "placement": { "$ref": "#/$defs/placement" }, "worldId": { "$ref": "#/$defs/id" }, "spoiler": { "enum": ["none", "mild", "major"] }, "uncertainty": { "type": "string" }, "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "characterIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "additionalProperties": false },
    "edge": { "type": "object", "required": ["id", "fromEventId", "toEventId", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "fromEventId": { "$ref": "#/$defs/id" }, "toEventId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["leads-to", "branches-to", "returns-to", "related"] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
